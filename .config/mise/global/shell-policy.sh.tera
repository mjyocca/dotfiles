{% set policy = vars.dotfiles_runtime_manager ~ "+" ~ vars.dotfiles_environment_loader -%}
{% if policy not in ["asdf+direnv", "mise+direnv", "mise+mise"] -%}
{{ throw(message="Supported runtime+environment policies: asdf+direnv, mise+direnv, mise+mise") }}
{% endif -%}
# Generated by mise dotfiles. Edit the checkout's config.local.toml, not this file.
# Open a fresh shell after deploying a different policy.
DOTFILES_ENVIRONMENT_LOADER={{ vars.dotfiles_environment_loader | quote }}
DOTFILES_RUNTIME_MANAGER={{ vars.dotfiles_runtime_manager | quote }}
