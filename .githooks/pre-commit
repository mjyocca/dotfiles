#!/usr/bin/env bash
# Pre-commit hook to scan staged changes for secrets using gitleaks
# Install: make hooks
# Requires: gitleaks on PATH or installed through the tracked mise declaration

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
source "$repo_root/scripts/shared/environment.sh"

# GUI Git clients and fresh bootstrap shells may not have mise tools on PATH.
if ! scanner="$(command -v gitleaks)"; then
  if ! scanner="$(mise -C "$repo_root" which gitleaks --tool gitleaks 2>/dev/null)"; then
    echo "⚠️  gitleaks not found. Skipping secret scan."
    echo "   Install tracked tools with: make tools"
    exit 0
  fi
fi

echo "🔍 Scanning staged changes for secrets..."

# Run gitleaks on staged changes only
# --staged: only scan staged files (not entire repo)
# --redact: hide secret values in output
# --verbose: show detailed results
if "$scanner" protect --staged --redact --verbose; then
  echo "✅ No secrets detected in staged changes"
  exit 0
else
  echo ""
  echo "❌ Secrets detected in staged changes!"
  echo ""
  echo "To fix:"
  echo "  1. Remove the secrets from your code"
  echo "  2. Use environment variables or a secrets manager"
  echo "  3. Add false positives to .gitleaks.toml (see docs)"
  echo ""
  echo "To bypass (NOT recommended):"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi
