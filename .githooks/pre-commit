#!/usr/bin/env bash
# Pre-commit hook to scan staged changes for secrets using gitleaks
# Install: make hooks
# Requires: gitleaks on PATH or installed through the tracked mise declaration

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
source "$repo_root/scripts/shared/environment.sh"

# GUI Git clients and fresh bootstrap shells may not have mise tools on PATH.
if ! scanner="$(command -v gitleaks)"; then
  if ! scanner="$(mise -C "$repo_root" which gitleaks --tool gitleaks 2>/dev/null)"; then
    echo "❌ gitleaks not found. Commit blocked: secret scan could not run." >&2
    echo "   Install tracked tools with: make tools"
    exit 1
  fi
fi

echo "🔍 Scanning staged changes for secrets..."

# Use the repository's policy even when a shell has GITLEAKS_CONFIG set.
# A dedicated findings exit code distinguishes leaks from scanner errors.
if "$scanner" git --pre-commit --staged --redact --verbose \
  --config "$repo_root/.gitleaks.toml" --exit-code 10; then
  echo "✅ No secrets detected in staged changes"
  exit 0
else
  scan_status=$?
fi

echo ""
if [[ "$scan_status" -eq 10 ]]; then
  echo "❌ Secrets detected in staged changes. Commit blocked."
  echo "Remove credentials and use environment variables or a secrets manager."
  echo "Rotate exposed credentials; review false positives before adding narrow exceptions."
else
  echo "❌ Secret scan failed (exit $scan_status). Commit blocked." >&2
  echo "Fix the scanner or configuration error above and retry." >&2
fi
exit 1
