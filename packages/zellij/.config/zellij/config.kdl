theme "ansi"
default_shell "zsh"
// pane_frames false
// Restore pre-0.45.0 rendering: full-border frames + stacked panes expanded in place
pane_frame_style "full"
stacked_pane_list false
default_mode "normal"
default_layout "default"
attach_to_session true
show_startup_tips false

// zellij-autolock v0.2.2 — download: https://github.com/fresh2dev/zellij-autolock/releases/tag/0.2.2
plugins {
    autolock location="file:~/.config/zellij/plugins/zellij-autolock.wasm" {
        is_enabled true
        triggers "nvim|vim|git|fzf|zoxide|atuin"
        reaction_seconds "0.3"
        print_to_log false
    }
}

load_plugins {
    autolock
}

keybinds {
    normal {
        bind "Enter" {
            WriteChars "\u{000D}";
            MessagePlugin "autolock" {};
        }
        bind "Ctrl z" { SwitchToMode "Tmux"; }
    }

    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
        bind "Alt z" {
            MessagePlugin "autolock" {payload "disable";};
            SwitchToMode "Normal";
        }
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
    }

    tmux {
        bind "&" { CloseFocus; SwitchToMode "Normal"; }
    }

    shared_except "locked" {
        bind "Alt z" {
            MessagePlugin "autolock" {payload "enable";};
        }
        bind "Ctrl h" { MoveFocusOrTab "Left"; }
        bind "Ctrl l" { MoveFocusOrTab "Right"; }
        bind "Ctrl j" { MoveFocus "Down"; }
        bind "Ctrl k" { MoveFocus "Up"; }
    }

    shared_except "normal" "locked" {
        bind "Enter" "Esc" { SwitchToMode "Normal"; }
    }

    shared_except "pane" "locked" {
        bind "Ctrl p" { SwitchToMode "Pane"; }
    }

    shared_except "resize" "locked" {
        bind "Ctrl n" { SwitchToMode "Resize"; }
    }

    shared_except "scroll" "locked" {
        bind "Ctrl s" { SwitchToMode "Scroll"; }
    }

    shared_except "tab" "locked" {
        bind "Ctrl t" { SwitchToMode "Tab"; }
    }

    shared_except "move" "locked" {
        bind "Ctrl h" { SwitchToMode "Move"; }
    }

    shared_except "tmux" "locked" {
        bind "Ctrl b" { SwitchToMode "Tmux"; }
    }
}
