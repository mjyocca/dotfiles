# NOTE: If want to auto login to tmux session
# command = /bin/zsh --login -c 'tmux new-session -A -D'
shell-integration = zsh
confirm-close-surface = false

# Font
font-size = 16
# font-style-bold = true
# font-style-bold-italic = false
font-family = "FiraCode Nerd Font"
window-title-font-family = "FiraCode Nerd Font"

# Behavior
window-save-state = always
macos-titlebar-style = tabs

# Theming
theme = GitHub Dark Default
palette-generate = true

# Default (GitHub Dark Default):
# palette = 0=#484f58
# palette = 1=#ff7b72
# palette = 2=#3fb950
# palette = 3=#d29922
# palette = 4=#58a6ff
# palette = 5=#bc8cff
# palette = 6=#39c5cf
# palette = 7=#b1bac4
# palette = 8=#6e7681
# palette = 9=#ffa198
# palette = 10=#56d364
# palette = 11=#e3b341
# palette = 12=#79c0ff
# palette = 13=#d2a8ff
# palette = 14=#56d4dd
# palette = 15=#ffffff

# Custom (from your github-custom.json):
palette = 1=#f85149
palette = 2=#3fb950
palette = 3=#d29922
palette = 4=#58a6ff
palette = 5=#bc8cff
palette = 6=#39c5cf
palette = 7=#c9d1d9
palette = 9=#cf222e
palette = 10=#1a7f37
palette = 11=#9a6700
palette = 12=#0969da
palette = 13=#8250df
palette = 14=#1b7c83

background-opacity = 0.88
background-blur-radius = 65
window-padding-x = 8,8
window-padding-y = 8,8

# For Recording
# macos-titlebar-style = hidden
# background-opacity = 0.78
# background-blur-radius = 35

# Quick Terminal
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Vim Style Navigation for ghostty splits
# keybind = cmd+shift+h=goto_split:left
# keybind = cmd+shift+j=goto_split:bottom
# keybind = cmd+shift+k=goto_split:top
# keybind = cmd+shift+l=goto_split:right

# NOTE: Testing out tmux style trigger sequence
# instead of: `ctrl+s>h`, trying: `shift+s`.
keybind = ctrl+s>h=goto_split:left
keybind = ctrl+s>j=goto_split:bottom
keybind = ctrl+s>k=goto_split:top
keybind = ctrl+s>l=goto_split:right

# Tmux style management for adding,removing,navigating splits
keybind = ctrl+s>shift+5=new_split:right
keybind = ctrl+s>shift+'=new_split:down
keybind = ctrl+s>c=new_tab
keybind = ctrl+s>n=next_tab
keybind = ctrl+s>p=previous_tab
keybind = ctrl+s>shift+7=close_surface

# Reload Config
keybind = cmd+shift+r=reload_config

custom-shader = ./shaders/cursor_warp.glsl
