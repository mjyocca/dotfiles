.DS_STORE

.scratch

.env
.envrc

# Per-machine zsh overrides — not committed
packages/zsh/.zshrc.local

# Per-machine bash overrides — not committed
packages/bash/.bashrc.local

# Per-machine stow ignore list — not committed
.stow-ignore.local

# Colima: ignore all runtime envs, keep tracked example config
packages/colima/.config/**
!packages/colima/.config/colima/
!packages/colima/.config/colima/_templates/
!packages/colima/.config/colima/_templates/default.yaml

# Zellij: ignore compiled wasm plugins (download via: make zellij-plugins)
packages/zellij/.config/zellij/plugins/*.wasm

# Opencode
opencode.json
opencode.jsonc

.opencode/plans/**
.opencode/plan/**
packages/opencode/.opencode/plan/**
