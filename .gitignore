.DS_STORE

.scratch

.env
.envrc

# Private project mise overrides, including environment-specific variants.
mise.local.toml
mise.*.local.toml
.mise.local.toml
.mise.*.local.toml

# Checkout-specific mise deployment exceptions (never deployed).
.miserc.local.toml
.config/mise/config.local.toml
.config/mise/config.*.local.toml

# Private workspace provisioning, seeded from a tracked example.
.config/mise/conf.d/workspace.toml

# Per-machine zsh overrides — not committed
packages/zsh/.zshrc.local

# Per-machine bash overrides — not committed
packages/bash/.bashrc.local

# Per-machine Git overrides — not committed or deployed by the Git manifest
packages/gitconfig/.gitconfig.local

# Colima: ignore all runtime envs, keep tracked example config
packages/colima/.config/**
!packages/colima/.config/colima/
!packages/colima/.config/colima/_templates/
!packages/colima/.config/colima/_templates/default.yaml

# Zellij: ignore compiled wasm plugins (download via: make plugins)
packages/zellij/.config/zellij/plugins/*.wasm

# Opencode
opencode.json
opencode.jsonc

.opencode/plans/**
.opencode/plan/**
packages/opencode/.opencode/plan/**
